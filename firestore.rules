rules_version = '2';

// デジタル得点表 のセキュリティルール
// - users/{uid}        : プロフィール（生徒: studentNo / 先生: email、role = 'student' | 'teacher'）
// - config/teachers    : 先生として登録できるメールアドレスの一覧（先生だけが読み書き）
// - config/settings    : 生徒の自己登録を受け付けるか（だれでも読める・先生だけが書ける）
// - workbooks/{id}     : 得点表の構成（先生が作成。公開中のものだけ生徒が読める）
// - scores/{wb_uid}    : 生徒の点数（平均・順位の計算のため、ログイン済みなら読める。名前は含まない）
// - notes/{wb_uid}     : 目標点・振り返りメモ（本人と先生だけ）
//
// ※ studentEmailDomain() は public/firebase-config.js の studentEmailDomain と同じ値にしてください。

service cloud.firestore {
  match /databases/{database}/documents {

    function studentEmailDomain() { return 'score-note.local'; }

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function isTeacher() { return hasProfile() && get(userPath(request.auth.uid)).data.role == 'teacher'; }
    function isStudent() { return hasProfile() && get(userPath(request.auth.uid)).data.role == 'student'; }

    function validName(d) { return d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 40; }
    function validStudent(d) {
      return d.keys().hasOnly(['studentNo', 'displayName', 'role', 'mustChangePassword', 'createdAt'])
        && d.role == 'student' && d.studentNo is string && d.studentNo.matches('^[0-9]{4}$') && validName(d);
    }
    function validTeacher(d) {
      return d.keys().hasOnly(['email', 'displayName', 'role', 'mustChangePassword', 'createdAt'])
        && d.role == 'teacher' && d.email is string && validName(d);
    }

    function selfSignupOpen() {
      return exists(/databases/$(database)/documents/config/settings)
        && get(/databases/$(database)/documents/config/settings).data.get('selfSignup', false) == true;
    }
    function teacherAllowed(email) {
      return exists(/databases/$(database)/documents/config/teachers)
        && get(/databases/$(database)/documents/config/teachers).data.get('emails', []).hasAny([email]);
    }

    match /config/settings {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /config/teachers {
      allow read, write: if isTeacher();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());

      allow create: if
        // 生徒の自己登録（先生が受け付けをオンにしている間だけ）
        (signedIn() && request.auth.uid == uid && validStudent(request.resource.data)
          && request.auth.token.email == 's' + request.resource.data.studentNo + '@' + studentEmailDomain()
          && request.resource.data.mustChangePassword == false
          && selfSignupOpen())
        // 先生の登録（確認済みのメールアドレスが許可リストにある場合だけ）
        || (signedIn() && request.auth.uid == uid && validTeacher(request.resource.data)
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == request.resource.data.email
          && teacherAllowed(request.resource.data.email))
        // 先生による生徒アカウントの作成
        || (isTeacher() && validStudent(request.resource.data));

      // 本人は「初回パスワード変更済み」の印だけ更新できる。先生は名前などを更新できる（出席番号・メールは変更不可）。
      allow update: if (signedIn() && request.auth.uid == uid
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
                         && request.resource.data.mustChangePassword == false)
                    || (isTeacher() && (
                         (validStudent(request.resource.data) && request.resource.data.studentNo == resource.data.studentNo)
                         || (validTeacher(request.resource.data) && request.resource.data.email == resource.data.email)));

      allow delete: if isTeacher() && request.auth.uid != uid;
    }

    match /workbooks/{wbId} {
      allow read: if isTeacher() || (hasProfile() && resource.data.published == true);
      allow write: if isTeacher();
    }

    match /scores/{docId} {
      allow read: if hasProfile();
      allow create, update: if (
          isStudent()
          && request.resource.data.uid == request.auth.uid
          && docId == request.resource.data.wbId + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['wbId', 'uid', 'scores', 'dates', 'updatedAt'])
          && request.resource.data.scores is map
          && exists(/databases/$(database)/documents/workbooks/$(request.resource.data.wbId))
        ) || (
          // 先生による点数の記入・修正（生徒のアカウントに対してだけ）
          isTeacher()
          && docId == request.resource.data.wbId + '_' + request.resource.data.uid
          && (resource == null || (request.resource.data.uid == resource.data.uid && request.resource.data.wbId == resource.data.wbId))
          && request.resource.data.keys().hasOnly(['wbId', 'uid', 'scores', 'dates', 'updatedAt'])
          && request.resource.data.scores is map
          && exists(/databases/$(database)/documents/workbooks/$(request.resource.data.wbId))
          && get(userPath(request.resource.data.uid)).data.role == 'student'
        );
      allow delete: if isTeacher();
    }

    match /notes/{docId} {
      allow read: if isTeacher() || (signedIn() && docId.matches('.+_' + request.auth.uid));
      allow create, update: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && docId == request.resource.data.wbId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['wbId', 'uid', 'goal', 'entries', 'updatedAt'])
        && request.resource.data.entries is map;
      allow delete: if isTeacher();
    }
  }
}
